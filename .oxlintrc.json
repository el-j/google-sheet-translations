{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "ignorePatterns": [
    "dist/**",
    "dist-cli/**",
    "dist-action/**",
    "coverage/**",
    "node_modules/**"
  ]
}
