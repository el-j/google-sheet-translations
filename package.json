{
  "name": "@el-j/google-sheet-translations",
  "version": "2.2.0-beta.11",
  "description": "A package to manage translations stored in Google Spreadsheets",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "gst-setup-wif": "./dist-cli/setup-wif.mjs",
    "gst-run-provider": "./dist-cli/run-provider.mjs",
    "gst-migrate-v3": "./dist-cli/migrate-v3.mjs"
  },
  "files": [
    "dist",
    "dist-cli",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:action": "rimraf dist-action && rolldown -c --environment BUILD_TARGET:action && node scripts/patch-action-bundle.mjs",
    "build:cli": "rimraf dist-cli && rolldown -c --environment BUILD_TARGET:cli",
    "build:types": "tsc --emitDeclarationOnly",
    "build:cjs": "rolldown -c --environment BUILD_TARGET:cjs",
    "build:esm": "rolldown -c --environment BUILD_TARGET:esm && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}))\"",
    "build": "npm run build:types && npm run build:cjs && npm run build:esm && npm run build:cli",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "test": "vitest run --coverage",
    "lint": "oxlint src/ --deny-warnings",
    "lint:fix": "oxlint src/ --fix",
    "format": "oxfmt --write src/ tests/",
    "format:check": "oxfmt --check src/ tests/",
    "dev": "tsc --watch",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "test:integration": "INTEGRATION=true vitest run tests/integration --testTimeout=60000",
    "test:provider-matrix": "vitest run tests/providers --testTimeout=60000",
    "sync:translations": "node scripts/sync-demo-translations.mjs",
    "changelog:preview": "node scripts/changelog-preview.mjs"
  },
  "keywords": [
    "google-sheets",
    "translations",
    "i18n",
    "nextjs",
    "typescript",
    "auto-translation",
    "machine-translation",
    "google-translate",
    "localization",
    "internationalization",
    "spreadsheet",
    "google-api",
    "google-spreadsheet"
  ],
  "author": "el-j",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "csv-parse": "^7.0.2",
    "google-auth-library": "^11.0.2",
    "google-spreadsheet": "^5.3.0"
  },
  "peerDependencies": {
    "typescript": ">=4.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "dotenv": "17.4.2",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.7",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^5.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "google-spreadsheet": {
      "google-auth-library": "^11.0.2"
    },
    "@actions/http-client": {
      "undici": "^7.0.0"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
