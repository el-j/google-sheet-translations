{
  "name": "google-sheet-translations-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @el-j/google-sheet-translations and its documentation site",
  "license": "MIT",
  "author": "el-j",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky || true",
    "build": "npm run build -w @el-j/google-sheet-translations",
    "build:action": "npm run build:action -w @el-j/google-sheet-translations",
    "test": "npm test -w @el-j/google-sheet-translations",
    "test:integration": "npm run test:integration -w @el-j/google-sheet-translations",
    "test:provider-matrix": "npm run test:provider-matrix -w @el-j/google-sheet-translations",
    "test:mutation": "npm run test:mutation -w @el-j/google-sheet-translations",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint packages/*/src --deny-warnings",
    "lint:fix": "oxlint packages/*/src --fix",
    "format": "oxfmt --write packages/*/src packages/*/tests",
    "format:check": "oxfmt --check packages/*/src packages/*/tests",
    "fix": "npm run lint:fix && npm run format",
    "clean": "npm run clean --workspaces --if-present",
    "docs:dev": "npm run dev -w @el-j/google-sheet-translations-docs",
    "docs:build": "npm run build -w @el-j/google-sheet-translations-docs",
    "docs:bundle": "npm run bundle -w @el-j/google-sheet-translations-docs",
    "docs:preview": "npm run preview -w @el-j/google-sheet-translations-docs",
    "sync:translations": "npm run sync:translations -w @el-j/google-sheet-translations-docs",
    "changelog:preview": "node scripts/changelog-preview.mjs",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "semantic-release": "^25.0.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "google-spreadsheet": {
      "google-auth-library": "^11.3.1"
    },
    "@actions/http-client": {
      "undici": "^7.30.1"
    },
    "npm": "11.21.1",
    "typed-rest-client": {
      "qs": "^6.16.1"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "lint-staged": {
    "packages/*/src/**/*.{js,ts,mjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "packages/*/tests/**/*.{js,ts,mjs}": [
      "oxfmt --write"
    ]
  }
}
