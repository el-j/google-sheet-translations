{
	"name": "@el-j/google-sheet-translations",
	"version": "0.0.1",
	"description": "A package to manage translations stored in Google Spreadsheets",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist",
		"prebuild": "npm run clean",
		"prepare": "npm run build",
		"test": "jest",
		"lint": "eslint . --ext .ts",
		"dev": "tsc --watch",
		"prerelease": "npm version prerelease --preid=alpha"
	},
	"keywords": [
		"google-sheets",
		"translations",
		"i18n",
		"nextjs",
		"typescript",
		"auto-translation",
		"machine-translation",
		"google-translate",
		"localization",
		"internationalization",
		"spreadsheet",
		"google-api",
		"google-spreadsheet"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"google-auth-library": "^10.7.0",
		"google-spreadsheet": "^5.3.0"
	},
	"peerDependencies": {
		"typescript": ">=4.0.0"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^25.9.2",
		"dotenv": "17.4.2",
		"jest": "^30.4.2",
		"jest-mock-extended": "^4.0.1",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.11",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=14.0.0"
	}
}
